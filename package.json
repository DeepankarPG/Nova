{
  "name": "payglocal-gcc",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "rm -f .next/dev/lock && next dev",
    "dev:atlas": "npm run dev -w @payglocal/atlas-docs",
    "dev:ui-docs": "npm run dev -w @payglocal/ui-docs",
    "dev:ui-docs:fresh": "rm -f apps/payglocal-ui-docs/.next/dev/lock && npm run dev -w @payglocal/ui-docs",
    "dev:docs": "npm run dev -w @payglocal/ui-docs",
    "build": "next build",
    "build:atlas": "npm run build -w @payglocal/atlas-docs",
    "build:ui-docs": "npm run build -w @payglocal/ui-docs",
    "start": "next start",
    "lint": "eslint",
    "lint:atlas": "npm run lint -w @payglocal/atlas-docs",
    "lint:ui-docs": "npm run lint -w @payglocal/ui-docs",
    "publish:ui": "npm publish -w @payglocal/ui --access public",
    "ui:check-types": "npm run check-types -w @payglocal/ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@payglocal/ui": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.37.0",
    "html2canvas-pro": "^2.3.3",
    "jspdf": "^4.2.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "simple-icons": "^16.14.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
