{
  "name": "@payglocal/ui",
  "version": "0.1.0",
  "description": "PayGlocal UI primitives — inputs, fields, dialog, data table, charts, and more (Tailwind v4 + Radix).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
